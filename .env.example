# ============================================================================
# BidGuard 自托管配置模板
#
# 最快做法（自动生成含随机密钥的 .env）：
#     node deploy/gen-keys.mjs > .env
#     docker compose up -d --build
#
# 也可手动：复制本文件为 .env 并按下方说明填写。
# ============================================================================

# ---- 内置数据库（PostgreSQL 容器）----
# 自定义超级用户密码；建议只用字母数字，避免 URI 特殊字符
POSTGRES_PASSWORD=change-me-please

# ---- API 鉴权密钥（由 deploy/gen-keys.mjs 生成）----
# 三者必须配套：内置 PostgREST 用 JWT_SECRET 校验，
# 应用用 ANON_KEY / SERVICE_ROLE_KEY 作为 Bearer Token 访问
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- 单文件上传上限（MB），默认 200 ----
MAX_UPLOAD_MB=200

# ---- 分发镜像（仅使用预构建镜像时需要）----
# 填发布者提供的镜像地址；留空则使用本地构建的 bidguard:local
# BIDGUARD_IMAGE=ghcr.io/your-org/bidguard:latest

# ---- 服务端默认大模型（可选；留空则由使用者在网页右上角「模型设置」自带）----
# 默认走 compose 内置的 Ollama（免费，无需密钥）：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b

# 云端方案 A：DeepSeek（性价比高，支持 JSON 结构化输出）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=

# 云端方案 B：OpenAI 或任意 OpenAI 兼容端点
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=

# 注意：本项目要求模型支持 response_format=json_object（结构化 JSON 输出），
# 如 DeepSeek 请用 deepseek-chat 而非 deepseek-reasoner。
